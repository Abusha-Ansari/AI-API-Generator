# Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Optional Server Fallback API Keys
# SpecForge supports Bring Your Own Key (BYOK) directly in the browser UI.
# Leave these blank for self-hosted BYOK deployments, or populate them to
# provide optional server-side fallback keys when a user leaves the key field empty.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
